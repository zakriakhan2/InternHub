@model List<InternHub.Models.InternTask>
@using InternHub.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My tasks";
    ViewBag.Eyebrow = "Student";
    ViewBag.RoleTag = "Student";

    (string cssClass, string label) StatusPill(InternTaskStatus status) => status switch
    {
        InternTaskStatus.Assigned => ("pill-idle", "Assigned"),
        InternTaskStatus.InProgress => ("pill-active", "In progress"),
        InternTaskStatus.InReview => ("pill-review", "In review"),
        InternTaskStatus.ChangesRequested => ("pill-overdue", "Changes requested"),
        InternTaskStatus.Approved => ("pill-active", "Approved"),
        _ => ("pill-idle", status.ToString())
    };
}

@section SidebarNav {
    <ul class="nav flex-column gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Overview
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Student" asp-action="Tasks">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                My tasks <span class="badge bg-white bg-opacity-10 rounded-pill">@Model.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Messages" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Messages
            </a>
        </li>
    </ul>
}

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm text-center p-4">
                <p class="text-muted mb-0">No tasks assigned yet. Your supervisor will assign your first task soon.</p>
            </div>
        </div>
    }
    else
    {
        foreach (var task in Model)
        {
            var (cssClass, label) = StatusPill(task.Status);
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="d-block">@task.Title</strong>
                                <small class="text-muted font-mono">@(task.DueDate?.ToString("MMM d") ?? "No due date")</small>
                            </div>
                            <span class="pill @cssClass"><span class="dot"></span>@label</span>
                        </div>
                        <p class="small text-muted">@task.Description</p>
                        @if (task.Status == InternTaskStatus.InReview)
                        {
                            <button class="btn btn-outline-secondary btn-sm" disabled>Submitted — awaiting feedback</button>
                        }
                        else if (task.Status == InternTaskStatus.Approved)
                        {
                            <div class="small text-muted">✓ Approved</div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalShowcase" data-task-id="@task.Id" data-task-title="@task.Title">Showcase work</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="modal fade" id="modalShowcase" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Student" asp-action="ShowcaseTask" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" id="showcaseTaskId" />
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Showcase your work</h5><small class="text-muted">Sent straight to your supervisor for review.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Task</label>
                        <input class="form-control" id="showcaseTaskTitle" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">What did you complete?</label>
                        <textarea class="form-control" name="note" rows="3" placeholder="Summarize what's ready for review…"></textarea>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Attach work</label>
                        <input class="form-control" type="file" name="attachment" />
                        <div class="form-text">Link a repo, upload a file, or attach a screenshot.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit for review</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalShowcase').addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget;
            document.getElementById('showcaseTaskId').value = button.getAttribute('data-task-id');
            document.getElementById('showcaseTaskTitle').value = button.getAttribute('data-task-title');
        });
    </script>
}