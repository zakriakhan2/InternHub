@model List<InternHub.Models.User>
@using InternHub.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "All users";
    ViewBag.Eyebrow = "Admin";
    ViewBag.RoleTag = "Admin";

    var unassignedStudents = ViewBag.UnassignedStudentsList as List<User> ?? new List<User>();
    var allSupervisors = ViewBag.AllSupervisorsList as List<User> ?? new List<User>();

    string currentRole = ViewBag.Role ?? "";
    string currentSearch = ViewBag.Search ?? "";
    string currentSort = ViewBag.SortBy ?? "created_desc";
    string currentAssignment = ViewBag.Assignment ?? "";
}

@section SidebarNav {
    <ul class="nav flex-column gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Overview
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Admin" asp-action="AllUsers">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                All users <span class="badge bg-white bg-opacity-10 rounded-pill">@ViewBag.TotalUsers</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Admin" asp-action="Assignments">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                Assignments
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Messages" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Messages &amp; groups
            </a>
        </li>
    </ul>
}

@section TopbarActions {
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAssign">+ Assign supervisor</button>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 px-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3">@TempData["Error"]</div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="AllUsers" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Account type</label>
                <select class="form-select form-select-sm" name="role">
                    <option value="" selected="@(currentRole == "")">All types (@ViewBag.TotalUsers)</option>
                    <option value="Admin" selected="@(currentRole == "Admin")">Admin (@ViewBag.AdminCount)</option>
                    <option value="Supervisor" selected="@(currentRole == "Supervisor")">Supervisor (@ViewBag.SupervisorCount)</option>
                    <option value="Student" selected="@(currentRole == "Student")">Student (@ViewBag.StudentCount)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Assignment status</label>
                <select class="form-select form-select-sm" name="assignment">
                    <option value="" selected="@(currentAssignment == "")">Any</option>
                    <option value="assigned" selected="@(currentAssignment == "assigned")">Assigned students</option>
                    <option value="unassigned" selected="@(currentAssignment == "unassigned")">Unassigned students</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Sort by</label>
                <select class="form-select form-select-sm" name="sortBy">
                    <option value="created_desc" selected="@(currentSort == "created_desc")">Newest first</option>
                    <option value="created_asc" selected="@(currentSort == "created_asc")">Oldest first</option>
                    <option value="name_asc" selected="@(currentSort == "name_asc")">Name (A–Z)</option>
                    <option value="name_desc" selected="@(currentSort == "name_desc")">Name (Z–A)</option>
                    <option value="role" selected="@(currentSort == "role")">Account type</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Search</label>
                <div class="d-flex gap-1">
                    <input class="form-control form-control-sm" name="search" value="@currentSearch" placeholder="Name or email…" />
                    <button type="submit" class="btn btn-primary btn-sm">Go</button>
                </div>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(currentRole) || !string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentAssignment) || currentSort != "created_desc")
        {
            <a asp-controller="Admin" asp-action="AllUsers" class="d-inline-block mt-2 small">Clear filters</a>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white small text-muted">@Model.Count result@(Model.Count == 1 ? "" : "s")</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Type</th><th>Assigned to / team</th><th>Joined</th><th></th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No accounts match these filters.</td></tr>
                }
                else
                {
                    foreach (var u in Model)
                    {
                        <tr>
                            <td><div class="d-flex align-items-center gap-2"><div class="avatar avatar-sm avatar-1">@u.FirstName[0]@u.LastName[0]</div><div><strong class="d-block">@u.FullName</strong><small class="text-muted">@u.Email</small></div></div></td>
                            <td>
                                @if (u.Role == UserRole.Admin)
                                {
                                    <span class="badge bg-dark">Admin</span>
                                }
                                else if (u.Role == UserRole.Supervisor)
                                {
                                    <span class="badge bg-accent-soft">Supervisor</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-soft text-dark">Student</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @if (u.Role == UserRole.Supervisor)
                                {
                                    <text>@u.AssignedStudents.Count students</text>
                                }
                                else if (u.Role == UserRole.Student)
                                {
                                    @(u.Supervisor?.FullName ?? "Unassigned")
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td class="text-muted small font-mono">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                @if (u.Role == UserRole.Student && u.SupervisorId == null)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAssign" data-student-id="@u.Id">Assign</button>
                                }
                                @if (u.Role == UserRole.Student)
                                {
                                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#modalPromote" data-user-id="@u.Id">Promote</button>
                                }
                                <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalDelete" data-user-id="@u.Id" data-user-name="@u.FullName">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Assign supervisor modal -->
<div class="modal fade" id="modalAssign" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="AssignSupervisor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Assign a supervisor</h5><small class="text-muted">Pair a student with a supervisor.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student</label>
                        <select class="form-select" name="studentId" id="assignStudentSelect">
                            @foreach (var s in unassignedStudents)
                            {
                                <option value="@s.Id">@s.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Supervisor</label>
                        <select class="form-select" name="supervisorId">
                            @foreach (var sup in allSupervisors)
                            {
                                <option value="@sup.Id">@sup.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign supervisor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Promote to supervisor modal -->
<div class="modal fade" id="modalPromote" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="PromoteToSupervisor" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="promoteUserId" />
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Promote to supervisor</h5><small class="text-muted">This changes what the account can do.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-0">Promoting removes the student from any current supervisor pairing and gives them access to assign tasks and manage their own students.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Confirm promotion</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="DeleteUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Delete account</h5><small class="text-muted">This can't be undone.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Delete <strong id="deleteUserName"></strong>'s account permanently? This fails if they still have tasks or assigned students on record.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalPromote').addEventListener('show.bs.modal', function(event) {
            document.getElementById('promoteUserId').value = event.relatedTarget.getAttribute('data-user-id');
        });
        document.getElementById('modalAssign').addEventListener('show.bs.modal', function(event) {
            var studentId = event.relatedTarget.getAttribute('data-student-id');
            if (studentId) document.getElementById('assignStudentSelect').value = studentId;
        });
        document.getElementById('modalDelete').addEventListener('show.bs.modal', function(event) {
            document.getElementById('deleteUserId').value = event.relatedTarget.getAttribute('data-user-id');
            document.getElementById('deleteUserName').textContent = event.relatedTarget.getAttribute('data-user-name');
        });
    </script>
}