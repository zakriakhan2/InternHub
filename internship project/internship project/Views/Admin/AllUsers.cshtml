@model List<InternHub.Models.User>
@using InternHub.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "All users";
    ViewBag.Eyebrow = "Admin";
    ViewBag.RoleTag = "Admin";

    string fullName = User.Identity?.Name ?? "Admin";
    string initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (initials.Length == 0) initials = "?";

    var unassignedStudents = Model.Where(u => u.Role == UserRole.Student && u.SupervisorId == null).ToList();
    var allSupervisors = Model.Where(u => u.Role == UserRole.Supervisor).ToList();
    int adminCount = Model.Count(u => u.Role == UserRole.Admin);
    int supervisorCount = Model.Count(u => u.Role == UserRole.Supervisor);
    int studentCount = Model.Count(u => u.Role == UserRole.Student);
}

@section SidebarNav {
    <ul class="nav flex-column gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Overview
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Admin" asp-action="AllUsers">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                All users <span class="badge bg-white bg-opacity-10 rounded-pill">@Model.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Admin" asp-action="Assignments">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                Assignments
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Messages" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Messages &amp; groups
            </a>
        </li>
    </ul>
}

@section SidebarUser {
    <a href="#" class="sidebar-user text-decoration-none">
        <div class="avatar avatar-ink">@initials</div>
        <div><strong class="d-block text-white" style="font-size:.85rem;">@fullName</strong><small>Admin</small></div>
    </a>
}

@section TopbarActions {
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAssign">+ Assign supervisor</button>
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <ul class="nav nav-pills gap-1" id="roleFilter">
        <li class="nav-item"><button class="nav-link active" data-filter="all">All <span class="badge bg-white bg-opacity-25 ms-1">@Model.Count</span></button></li>
        <li class="nav-item"><button class="nav-link" data-filter="Admin">Admins <span class="badge bg-secondary ms-1">@adminCount</span></button></li>
        <li class="nav-item"><button class="nav-link" data-filter="Supervisor">Supervisors <span class="badge bg-secondary ms-1">@supervisorCount</span></button></li>
        <li class="nav-item"><button class="nav-link" data-filter="Student">Students <span class="badge bg-secondary ms-1">@studentCount</span></button></li>
    </ul>
    <input class="form-control form-control-sm" style="width:220px;" id="userSearch" placeholder="Search people…" />
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light"><tr><th>Name</th><th>Role</th><th>Assigned to / team</th><th>Joined</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr data-role="@u.Role">
                        <td><div class="d-flex align-items-center gap-2"><div class="avatar avatar-sm avatar-1">@u.FirstName[0]@u.LastName[0]</div><div><strong class="d-block">@u.FullName</strong><small class="text-muted">@u.Email</small></div></div></td>
                        <td>
                            @if (u.Role == UserRole.Admin)
                            {
                                <span class="badge bg-dark">Admin</span>
                            }
                            else if (u.Role == UserRole.Supervisor)
                            {

                                <span class="badge bg-accent-soft">Supervisor</span>
                            }
                            else
                            {

                                <span class="badge bg-primary-soft text-dark">Student</span>
                            }
                        </td>
                            <td class="text-muted small">
                                @if (u.Role == UserRole.Supervisor)
                                {
                                    <text>@u.AssignedStudents.Count students</text>
                                }
                                else
                                {
                                    @(u.Supervisor?.FullName ?? "—")
                                }
                            </td>
                        <td class="text-muted small font-mono">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                            @if (u.Role == UserRole.Student && u.SupervisorId == null)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAssign" data-student-id="@u.Id">Assign</button>
                                <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#modalPromote" data-user-id="@u.Id">Promote</button>
                            }
                            else if (u.Role == UserRole.Student)
                            {
                                <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#modalPromote" data-user-id="@u.Id">Promote</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Assign supervisor modal -->
<div class="modal fade" id="modalAssign" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="AssignSupervisor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Assign a supervisor</h5><small class="text-muted">Pair a student with a supervisor.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student</label>
                        <select class="form-select" name="studentId" id="assignStudentSelect">
                            @foreach (var s in unassignedStudents)
                            {
                                <option value="@s.Id">@s.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Supervisor</label>
                        <select class="form-select" name="supervisorId">
                            @foreach (var sup in allSupervisors)
                            {
                                <option value="@sup.Id">@sup.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign supervisor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Promote to supervisor modal -->
<div class="modal fade" id="modalPromote" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Admin" asp-action="PromoteToSupervisor" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="promoteUserId" />
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Promote to supervisor</h5><small class="text-muted">This changes what the account can do.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-0">Promoting removes the student from any current supervisor pairing and gives them access to assign tasks and manage their own students.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Confirm promotion</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalPromote').addEventListener('show.bs.modal', function(event) {
            document.getElementById('promoteUserId').value = event.relatedTarget.getAttribute('data-user-id');
        });
        document.getElementById('modalAssign').addEventListener('show.bs.modal', function(event) {
            var studentId = event.relatedTarget.getAttribute('data-student-id');
            if (studentId) document.getElementById('assignStudentSelect').value = studentId;
        });

        var filterBtns = document.querySelectorAll('#roleFilter button');
        var rows = document.querySelectorAll('#usersTable tbody tr');
        filterBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                filterBtns.forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                var role = btn.getAttribute('data-filter');
                rows.forEach(function(row) {
                    row.style.display = (role === 'all' || row.getAttribute('data-role') === role) ? '' : 'none';
                });
            });
        });
        document.getElementById('userSearch').addEventListener('input', function(e) {
            var q = e.target.value.toLowerCase();
            rows.forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}