@model List<InternHub.Models.InternTask>
@using InternHub.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tasks";
    ViewBag.Eyebrow = "Supervisor";
    ViewBag.RoleTag = "Supervisor";

    (string cssClass, string label) StatusPill(InternTaskStatus status) => status switch
    {
        InternTaskStatus.Assigned => ("pill-idle", "Assigned"),
        InternTaskStatus.InProgress => ("pill-active", "In progress"),
        InternTaskStatus.InReview => ("pill-review", "In review"),
        InternTaskStatus.ChangesRequested => ("pill-overdue", "Changes requested"),
        InternTaskStatus.Approved => ("pill-active", "Approved"),
        _ => ("pill-idle", status.ToString())
    };
}

@section SidebarNav {
    <ul class="nav flex-column gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Supervisor" asp-action="Dashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                My students
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Supervisor" asp-action="Tasks">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                Tasks <span class="badge bg-white bg-opacity-10 rounded-pill">@Model.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Messages" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Messages &amp; groups
            </a>
        </li>
    </ul>
}

@section TopbarActions {
    <button class="btn btn-accent btn-sm" data-bs-toggle="modal" data-bs-target="#modalTask">+ Assign task</button>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Task</th><th>Student</th><th>Due</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No tasks assigned yet. Use "Assign task" to get started.</td></tr>
                }
                else
                {
                    foreach (var task in Model)
                    {
                        var (cssClass, label) = StatusPill(task.Status);
                        <tr>
                            <td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none text-dark fw-semibold">@task.Title</a></td>
                            <td class="small">@task.Student.FullName</td>
                            <td class="small font-mono text-muted">@(task.DueDate?.ToString("MMM d") ?? "—")</td>
                            <td><span class="pill @cssClass"><span class="dot"></span>@label</span></td>
                            <td class="text-end"><a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="btn btn-light btn-sm">View</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalTask" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Supervisor" asp-action="AssignTask" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">Assign a task</h5><small class="text-muted">Sends instantly to the student.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student</label>
                        <select class="form-select" name="studentId">
                            @foreach (var student in ViewBag.Students as List<User> ?? new List<User>())
                            {
                                <option value="@student.Id">@student.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Task title</label>
                        <input class="form-control" name="title" placeholder="e.g. Build the login form" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Details</label>
                        <textarea class="form-control" name="description" rows="3" placeholder="What does 'done' look like for this task?"></textarea>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Due date</label>
                        <input class="form-control" type="date" name="dueDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Assign task</button>
                </div>
            </form>
        </div>
    </div>
</div>