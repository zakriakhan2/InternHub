@model IEnumerable<InternHub.Models.Conversation>
@using InternHub.Models
@{
    bool canCreateGroups = !User.IsInRole("Student");
    ViewData["Title"] = "Messages";
    ViewBag.Eyebrow = "Messages";
    ViewBag.RoleTag = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("Supervisor") ? "Supervisor" : "Student");

    string fullName = User.Identity?.Name ?? "User";
    string initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (initials.Length == 0) initials = "?";

    string avatarClass = User.IsInRole("Admin") ? "avatar-ink" : (User.IsInRole("Supervisor") ? "avatar-2" : "avatar-1");
}

@section SidebarNav {
    <ul class="nav flex-column gap-1">
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="AllUsers">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    All users
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Assignments">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    Assignments
                </a>
            </li>
        }
        else if (User.IsInRole("Supervisor"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Supervisor" asp-action="Dashboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Supervisor" asp-action="Tasks">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    Tasks
                </a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Student" asp-action="Tasks">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    Tasks
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Messages" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                Messages &amp; groups
            </a>
        </li>
    </ul>
}

@section SidebarUser {
    <a asp-controller="Account" asp-action="Settings" class="sidebar-user text-decoration-none">
        <div class="avatar @avatarClass">@initials</div>
        <div><strong class="d-block text-white" style="font-size:.85rem;">@fullName</strong><small>@ViewBag.RoleTag · Settings</small></div>
    </a>
}

@section TopbarActions {
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewMessage">New message</button>
    @if (canCreateGroups)
    {
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewGroup">+ New group</button>
    }
}

@section Styles {
    <style>
        .msg-shell {
            height: calc(100vh - 138px);
        }

        @@media (max-width: 900px) {
            .msg-shell {
                height: auto;
            }
        }
    </style>
}

@{
    int currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var selected = Model.FirstOrDefault(c => c.Id == (int?)ViewBag.SelectedConversationId);

    string ConvTitle(Conversation c) => c.IsGroup
        ? (c.Name ?? "Group")
        : (c.Participants.FirstOrDefault(p => p.UserId != currentUserId)?.User.FullName ?? "Conversation");

    string ConvInitials(Conversation c)
    {
        var name = ConvTitle(c);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var i = string.Concat(parts.Select(w => w[0])).ToUpper();
        return i.Length > 2 ? i.Substring(0, 2) : (i.Length == 0 ? "?" : i);
    }

    ViewData["SelectedConversationId"] = ViewBag.SelectedConversationId;
}

<div class="card border-0 shadow-sm msg-shell">
    <div class="chat-panel h-100">
        @await Html.PartialAsync("_ConversationList", Model)

        <div class="chat-body">
            @if (selected == null)
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-muted small">
                    Select a conversation, or start a new one.
                </div>
            }
            else
            {
                <div class="p-2 px-3 border-bottom d-flex align-items-center gap-2">
                    @{
                        var selectedOtherUser = !selected.IsGroup ? selected.Participants.FirstOrDefault(p => p.UserId != currentUserId)?.User : null;
                    }
                    @if (!selected.IsGroup && selectedOtherUser != null && !string.IsNullOrEmpty(selectedOtherUser.ProfilePicturePath))
                    {
                        <img src="@selectedOtherUser.ProfilePicturePath" class="avatar avatar-sm" style="object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <div class="avatar avatar-sm @(selected.IsGroup ? "avatar-4" : "avatar-2")">@ConvInitials(selected)</div>
                    }
                    <strong>@ConvTitle(selected)</strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-bs-toggle="modal" data-bs-target="#modalClearChat">Clear chat</button>
                    <form asp-controller="Messages" asp-action="DeleteConversationForMe" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="conversationId" value="@selected.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete chat</button>
                    </form>
                </div>
                <div class="chat-messages" id="chat-messages" data-conversation-id="@selected.Id">
                    @{
                        ViewData["ConversationId"] = selected.Id;
                        ViewData["IsGroup"] = selected.IsGroup;
                    }
                    @if (!selected.Messages.Any())
                    {
                        <div class="text-center text-muted small" data-empty-state>No messages yet — say hello.</div>
                    }
                    else
                    {
                        foreach (var msg in selected.Messages.OrderBy(m => m.SentAt))
                        {
                            @await Html.PartialAsync("_MessageBubble", msg)
                        }
                    }
                </div>
                <form class="d-flex gap-2 p-2 border-top js-ajax-form" id="send-form" asp-controller="Messages" asp-action="Send" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="conversationId" value="@selected.Id" />
                    <input class="form-control" name="body" placeholder="Type a message…" autocomplete="off" />
                    <button class="btn btn-primary" type="submit">Send</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- New message modal -->
<div class="modal fade" id="modalNewMessage" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Messages" asp-action="StartConversation" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div><h5 class="modal-title mb-0">New message</h5><small class="text-muted">Start a direct conversation with anyone.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">To</label>
                    <select class="form-select" name="otherUserId">
                        @foreach (var u in ViewBag.AllUsers as List<User> ?? new List<User>())
                        {
                            <option value="@u.Id">@u.FullName — @u.Role</option>
                        }
                    </select>
                    <div class="form-text">Any role can message any other role.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Start conversation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Forward message modal -->
<div class="modal fade" id="modalForward" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Messages" asp-action="ForwardMessage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="messageId" id="forwardMessageId" />
                <div class="modal-header">
                    <h5 class="modal-title mb-0">Forward message</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">Send to</label>
                    <select class="form-select" name="targetConversationId">
                        @foreach (var c in Model)
                        {
                            <option value="@c.Id">@ConvTitle(c)</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Forward</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Clear chat confirmation modal -->
<div class="modal fade" id="modalClearChat" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Messages" asp-action="ClearChat" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@(selected?.Id ?? 0)" />
                <div class="modal-header">
                    <h5 class="modal-title mb-0">Clear chat</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">This clears every message in this chat from your view only. The other person's copy is untouched, and this can't be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-outline-secondary">Clear chat</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (canCreateGroups)
{
    <div class="modal fade" id="modalNewGroup" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Messages" asp-action="CreateGroup" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <div><h5 class="modal-title mb-0">Create a group</h5><small class="text-muted">Students can join groups but can't create them.</small></div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Group name</label>
                            <input class="form-control" name="groupName" placeholder="e.g. Frontend Interns – Fall" />
                        </div>
                        <label class="form-label fw-semibold">Add members</label>
                        <div class="border rounded" style="max-height:220px;overflow-y:auto;">
                            @foreach (var u in ViewBag.AllUsers as List<User> ?? new List<User>())
                            {
                                <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                                    <div class="avatar avatar-sm avatar-1">@u.FirstName[0]@u.LastName[0]</div>
                                    <label class="form-check-label flex-fill">@u.FullName — @u.Role</label>
                                    <input class="form-check-input" type="checkbox" name="memberIds" value="@u.Id" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create group</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function() {
            const chatMessages = document.getElementById('chat-messages');
            const conversationId = chatMessages ? parseInt(chatMessages.dataset.conversationId, 10) : null;

            async function insertOrReplaceMessage(messageId) {
                const resp = await fetch(`/Messages/MessagePartial?messageId=${messageId}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) return;
                const html = await resp.text();
                if (!html.trim()) return;

                const existing = document.getElementById('msg-' + messageId);
                if (existing) {
                    existing.outerHTML = html;
                } else if (chatMessages) {
                    const empty = chatMessages.querySelector('[data-empty-state]');
                    if (empty) empty.remove();
                    chatMessages.insertAdjacentHTML('beforeend', html);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            }

            function refreshConversationList() {
                const list = document.getElementById('conversation-list');
                if (!list) return;
                fetch(`/Messages/ConversationListPartial?selected=${conversationId ?? ''}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.ok ? r.text() : null)
                    .then(html => { if (html) list.outerHTML = html; });
            }

            if (window.appHub) {
                window.appHub.on('ReceiveMessage', function(data) {
                    if (conversationId && data.conversationId === conversationId) insertOrReplaceMessage(data.messageId);
                });
                window.appHub.on('ConversationActivity', function() {
                    refreshConversationList();
                });
            }

            window.addEventListener('apphub-reconnected', function() {
                refreshConversationList();
                location.reload();
            });

            document.querySelectorAll('.js-ajax-form').forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(form);
                    fetch(form.action, { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function(resp) {
                            if (resp.ok && form.id === 'send-form') form.reset();
                        });
                });
            });

            document.getElementById('modalForward')?.addEventListener('show.bs.modal', function(event) {
                document.getElementById('forwardMessageId').value = event.relatedTarget.getAttribute('data-message-id');
            });

            window.startEdit = function(id) { document.getElementById('edit-form-' + id).classList.remove('d-none'); };
            window.cancelEdit = function(id) { document.getElementById('edit-form-' + id).classList.add('d-none'); };
        })();
    </script>
}
