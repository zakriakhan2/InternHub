@{
    string currentTheme = Context.Request.Cookies["theme"] == "dark" ? "dark" : "light";

    string sbFullName = User?.Identity?.Name ?? "";
    string sbRole = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string sbAvatarPath = User?.FindFirst("Avatar")?.Value ?? "";
    string sbInitials = "";
    if (!string.IsNullOrWhiteSpace(sbFullName))
    {
        var parts = sbFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        sbInitials = string.Concat(parts.Select(w => w[0])).ToUpper();
        if (sbInitials.Length > 2) sbInitials = sbInitials.Substring(0, 2);
    }
    if (string.IsNullOrEmpty(sbInitials)) sbInitials = "?";
    string sbAvatarClass = sbRole == "Admin" ? "avatar-ink" : sbRole == "Supervisor" ? "avatar-2" : "avatar-3";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - InternHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell d-flex" style="min-height:100vh;">
        <nav class="sidebar d-flex flex-column flex-shrink-0" style="width:264px;">
            <div class="brand">
                <div class="mark">IH</div>
                <div>
                    <div class="fw-semibold">InternHub</div>
                    <small>@ViewBag.RoleTag Console</small>
                </div>
            </div>

            @await RenderSectionAsync("SidebarNav", required: false)

            <div class="sidebar-footer mt-auto">
                @if (IsSectionDefined("SidebarUser"))
                {
                    @await RenderSectionAsync("SidebarUser", required: false)
                }
                else
                {
                    <a asp-controller="Account" asp-action="Settings" class="sidebar-user text-decoration-none">
                        @if (!string.IsNullOrEmpty(sbAvatarPath))
                        {
                            <img src="@sbAvatarPath" class="avatar" style="object-fit:cover;" alt="" />
                        }
                        else
                        {
                            <div class="avatar @sbAvatarClass">@sbInitials</div>
                        }
                        <div><strong class="d-block text-white" style="font-size:.85rem;">@sbFullName</strong><small>@sbRole · Settings</small></div>
                    </a>
                }
            </div>
        </nav>

        <div class="flex-fill" style="min-width:0;">
            <header class="bg-white border-bottom d-flex align-items-center gap-3 px-4 py-3 sticky-top">
                <div>
                    <span class="d-block font-mono text-primary text-uppercase" style="font-size:.7rem;letter-spacing:.07em;">@ViewBag.Eyebrow</span>
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @await RenderSectionAsync("TopbarActions", required: false)

                    <form asp-controller="Account" asp-action="SetTheme" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="theme" value="@(currentTheme == "dark" ? "light" : "dark")" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn btn-outline-secondary rounded-3" aria-label="Toggle dark mode">
                            @if (currentTheme == "dark")
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" /></svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                            }
                        </button>
                    </form>

                    <button class="btn btn-outline-secondary rounded-3" type="button" aria-label="Notifications">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    </button>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger rounded-3 d-flex align-items-center gap-1">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <div id="toast-stack" style="position:fixed; top:16px; right:16px; z-index:1080; display:flex; flex-direction:column; gap:8px;"></div>
        <script>
                window.appHub = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/app')
                    .withAutomaticReconnect()
                    .build();

                window.appHubReady = window.appHub.start().catch(function(err) {
                    console.error('SignalR connection failed', err);
                });

                window.appHub.onreconnected(function() {
                    window.dispatchEvent(new CustomEvent('apphub-reconnected'));
                });

                function showToast(title, body) {
                    const stack = document.getElementById('toast-stack');
                    if (!stack) return;

                    const el = document.createElement('div');
                    el.className = 'toast show';
                    el.style.cssText = 'min-width:260px;';

                    const header = document.createElement('div');
                    header.className = 'toast-header';
                    const strong = document.createElement('strong');
                    strong.className = 'me-auto';
                    strong.textContent = title || 'Notification';
                    const closeBtn = document.createElement('button');
                    closeBtn.type = 'button';
                    closeBtn.className = 'btn-close';
                    closeBtn.onclick = () => el.remove();
                    header.appendChild(strong);
                    header.appendChild(closeBtn);

                    const bodyDiv = document.createElement('div');
                    bodyDiv.className = 'toast-body';
                    bodyDiv.textContent = body || '';

                    el.appendChild(header);
                    el.appendChild(bodyDiv);
                    stack.appendChild(el);
                    setTimeout(() => el.remove(), 6000);
                }

                window.appHub.on('ReceiveNotification', function(n) {
                    showToast(n.title, n.body);
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>